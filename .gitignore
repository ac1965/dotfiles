# ===== まず全て無視 =====
*

# ディレクトリ探索を許可
!*/

# ===== トップレベルの設定ファイルを許可 =====
# 先頭の "/" はリポジトリルート直下限定を意味する。これが無いと
# 例えば "!README.md" は .config/emacs/README.md のような、同期
# 対象ディレクトリの奥深くにある同名ファイルにもマッチしてしまう。
!/.zshrc
!/.zshenv
!/.zstyles
!/.gitconfig
!/.gitconfig_global
!/.gitignore
!/.gitignore_global
!/.gitmodules
!/.latexmkrc
!/.vimrc
!/.vimperatorrc
!/.vimperatorrc.js
!/.docker-alias
!/.user_rc
!/.Brewfile
!/Brewfile
!/README.md
!/dotfiles.zsh
!/favorite-repos.txt
!/diffs.jsonl
!/messages.json

# ===== .config 配下 =====
!.config/Brewfiles/
!.config/Brewfiles/*.Brewfiles
!.config/fish/
!.config/fish/conf.d/
!.config/fish/conf.d/*.fish
!.config/nix/
!.config/nix/nix.conf
!.config/zsh/
!.config/zsh/.zshenv
!.config/zsh/.zshrc
!.config/zsh/.zprofile
!.config/zsh/.zstyles
!.config/zsh/.p10k.zsh
!.config/zsh/.zsh_plugins.txt
!.config/zsh/.zsh_plugins.zsh
!.config/zsh/.zfunctions/
!.config/zsh/.zfunctions/*
!.config/zsh/.zshrc.d/
!.config/zsh/.zshrc.d/*.zsh
!.config/zsh/.antidote/
!.config/zsh/.antidote/**
!.config/kew/
!.config/kew/kewrc

# doom / emacs はサブモジュールまたは別管理の場合あり(必要に応じて調整)
!.config/doom
!.config/emacs

# ===== iterm2 (状態エクスポートのみ。AppSupport はマシン固有パスへの
# シンボリックリンクなので下部の除外リストで明示的にブロックする) =====
!.config/iterm2/
!.config/iterm2/*.itermexport

# ===== .local/bin 配下(スクリプト類のみ)=====
!.local/bin/
!.local/bin/encrypt
!.local/bin/decrypt
!.local/bin/*.sh
!.local/bin/*.zsh
!.local/bin/*.py
!.local/bin/*.zh
!.local/share/
!.local/share/*

# ===== .local/share 配下(スクリプト類のみ)=====

# ===== .docs =====
!.docs/
!.docs/*.org

# ===== iterm2-colors =====
!iterm2-colors/
!iterm2-colors/*.itermcolors

# ===== .vim =====
!.vim/
!.vim/dein.toml

# ===== .vimperator (設定ファイルのみ、動的生成物は除外) =====
!.vimperator/
!.vimperator/colors/
!.vimperator/colors/*.vimp

# ============================================
# 明示的に除外(allow-list内でも念のため二重ブロック)
# ============================================
.config/zsh/.zsh_history
.config/zsh/.zcompdump
.config/zsh/.zcompcache/
.config/zsh/.zsh_sessions/
.config/zsh/.antidote/.github/
.config/zsh/.antidote/tests/
.config/zsh/.antidote/tools/
.config/zsh/.antidote/.bumpversion.cfg
.config/zsh/.antidote/.editorconfig
.config/zsh/.antidote/makefile
.config/cmus/
.local/share/
.local/state/
.local/bin/keychain_passwords.org
.local/bin/rvcmd
.local/bin/emacs
.local/bin/emacsclient
.local/bin/poetry
.local/bin/python3.*
.local/bin/narou
.local/bin/cuetag
.local/bin/aider
.local/bin/bagoup
.local/bin/claude
.viminfo
.markdown-preview.html
.vimperator/.vimperator*
.config/cagent/user-uuid
.config/cagent/.cagent_first_run
.config/iterm2/AppSupport
.config/uv/uv-receipt.json
.config/zsh/.zcompdump
.config/zsh/.zcompcache/
private/
