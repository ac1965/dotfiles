#!/bin/bash
# Since OpenSSL enc parsing can be brittle, call the cipher subcommand directly.
# AES-256-CBC + PBKDF2 (210k iterations), output perms via umask 077,
# then remove the source in order: gshred > shred > rm.
# Passphrase lives in the macOS Keychain (service: com.encrypt.aes256gcm,
# account: $KEYCHAIN_ACCOUNT or "private-archive"), accessed via the plain
# `security` CLI. (A custom Swift helper with a "trusted apps" ACL was tried
# to restrict access to this script alone, but SecTrustedApplicationCreateFromPath
# binds trust to the exact compiled binary — every source edit/rebuild broke
# the trust relationship and brought back an interactive confirmation dialog,
# which would hang unattended runs. Not worth the fragility for the marginal
# benefit, so this uses the same unrestricted access model as any other
# Keychain-backed credential.)
# Missing entries are generated and stored automatically; run
# keychain_store.sh beforehand to set a stronger passphrase by hand instead.
#
# Encrypt-then-MAC: a 32-byte HMAC-SHA256 tag is appended to the ciphertext
# so decrypt can detect tampering/corruption before decrypting. The MAC key
# is derived from the same passphrase via PBKDF2 with a fixed, non-secret
# salt distinct from the (random) salt used for the ciphertext itself, so
# it never reuses the actual encryption key. openssl's dgst/mac subcommands
# have no env-based key input, so this derived (non-master) key briefly
# appears on argv — the master passphrase itself never does.

set -euo pipefail

if [ $# -ne 1 ]; then
  echo "Usage: $0 <file>"
  exit 1
fi

in="$1"
out="$in.enc"
iter="${ITER:-210000}"
account="${KEYCHAIN_ACCOUNT:-private-archive}"
hmac_salt="646f7466686d6163"
service="com.encrypt.aes256gcm"

umask 077

if ! pass=$(security find-generic-password -s "$service" -a "$account" -w 2>/dev/null); then
  pass=$(openssl rand -base64 32)
  security add-generic-password -s "$service" -a "$account" -l "dotfiles encrypt/decrypt ($account)" -w "$pass" -U
  # This Keychain entry is local to this Mac only (not iCloud-synced — see
  # README for why). If nobody records the generated value now, decrypting
  # this archive on any other machine becomes permanently impossible — print
  # it once so it can be copied into a password manager immediately.
  cat >&2 <<PASSMSG
🔑 Generated new passphrase and stored in Keychain (service=$service, account=$account)
⚠️  This passphrase exists ONLY in this Mac's Keychain (not iCloud-synced).
    Save it in a password manager now — it will not be shown again:
    $pass

PASSMSG
fi

PASSPHRASE="$pass" openssl aes-256-cbc -e -pbkdf2 -iter "$iter" -salt -in "$in" -out "$out" -pass env:PASSPHRASE

mac_key=$(PASSPHRASE="$pass" openssl enc -aes-256-cbc -pbkdf2 -iter "$iter" -S "$hmac_salt" -pass env:PASSPHRASE -P 2>/dev/null | awk -F= '/^key=/{print $2}')
tag=$(openssl dgst -sha256 -hmac "$mac_key" -binary < "$out" | xxd -p -c 64 | tr -d '\n')
printf '%s' "$tag" | xxd -r -p >> "$out"

unset pass PASSPHRASE mac_key tag

if command -v gshred >/dev/null 2>&1; then
  gshred -u -- "$in"
elif command -v shred >/dev/null 2>&1; then
  shred -u -- "$in"
else
  rm -f -- "$in"
fi

echo "✅ Encrypted: $out"
